# ---------------------------------------------------------------------------
# SavorBite backend — copy to .env and fill in your own values.
# NEVER commit .env or expose these keys in the frontend.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed origins (e.g. the Vercel frontend URL)
CLIENT_URL=http://localhost:5173

# Supabase — Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only key with full database access. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used to verify Supabase Auth access tokens (Project Settings -> JWT Keys)
SUPABASE_JWT_SECRET=your-jwt-secret

# Paystack — Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Public URL the webhook is exposed at (set on your deployed backend)
PAYSTACK_CALLBACK_URL=http://localhost:5173/checkout

# Brevo (email) — https://www.brevo.com
BREVO_API_KEY=your-brevo-api-key
# Verified sender email
BREVO_SENDER_EMAIL=hello@savorbite.ng
BREVO_SENDER_NAME=SavorBite
# Owner email (receives order & support alerts)
BREVO_OWNER_EMAIL=hello@savorbite.ng
