# SavorBite frontend environment variables
# Prefix with VITE_ so Vite exposes them to the client code.
# Copy this file to .env and fill in your own values.
# NEVER commit .env or expose service-role keys in the frontend.

# Backend API base URL (Render URL in production, localhost in dev)
VITE_API_URL=http://localhost:5000

# Supabase — Project Settings -> API (public, safe in frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-supabase-key
